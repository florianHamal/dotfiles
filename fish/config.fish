# Bitwarden SSH Agent Integration
set -gx SSH_AUTH_SOCK "$HOME/.bitwarden-ssh-agent.sock"


function y
	set tmp (mktemp -t "yazi-cwd.XXXXXX")
	command yazi $argv --cwd-file="$tmp"
	if read -z cwd < "$tmp"; and [ "$cwd" != "$PWD" ]; and test -d "$cwd"
		builtin cd -- "$cwd"
	end
	command rm -f -- "$tmp"
end
